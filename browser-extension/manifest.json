{
  "manifest_version": 3,
  "name": "AURA Companion — Universal Media Sync",
  "version": "1.0.0",
  "description": "Seamlessly synchronizes playing browser media tabs with the AURA Windows desktop player.",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AURA Companion"
  }
}
